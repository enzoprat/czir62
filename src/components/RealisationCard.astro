---
/**
 * Fiche de chantier — traitement éditorial.
 *
 * Volontairement SANS cadre ni fond : une carte blanche à bord arrondi
 * répétée trois fois est le réflexe qui aplatit une page. Ici l'image porte
 * le bloc, le texte se pose dessous sur le fond de page, et un filet
 * capillaire tient l'ensemble. C'est la mise en page d'un portfolio ou d'une
 * revue, pas d'un tableau de bord.
 *
 * N'affiche que des informations réellement renseignées.
 */
import PhotoSlot from '@/components/PhotoSlot.astro';
import Icon from '@/components/Icon.astro';
import { getService } from '@/data/services';
import { getVille } from '@/data/villes';
import { formatDateFr, type Realisation } from '@/lib/realisations';

interface Props { entry: Realisation }
const { entry } = Astro.props;
const d = entry.data;

const service = getService(d.service);
const ville = getVille(d.ville);
const url = `/realisations/${entry.id}/`;
---

<article class="rea">
  <div class="rea__frame">
    {d.draft && <span class="rea__draft">Exemple — non publié</span>}
    <PhotoSlot
      src={d.photo?.src}
      alt={d.photo?.alt ?? `${d.titre} — chantier réalisé par CZIR62`}
      need={`Photo du chantier : ${d.titre}`}
      ratio="4 / 3"
      icon={service.icon}
      rounded={false}
      sizes="(max-width: 700px) 100vw, 33vw"
    />
  </div>

  <p class="rea__meta">
    <span class="rea__svc">{service.name}</span>
    <span class="rea__sep" aria-hidden="true">/</span>
    <span>{ville.name}</span>
  </p>

  <h3 class="rea__title"><a href={url} class="stretch">{d.titre}</a></h3>
  <p class="rea__resume">{d.resume}</p>

  <p class="rea__foot num">
    <Icon name="calendar" size={13} />
    <span>{formatDateFr(d.date)}{d.surface ? ` · ${d.surface} m²` : ''}{d.duree ? ` · ${d.duree}` : ''}</span>
  </p>
</article>

<style>
  .rea { position: relative; display: flex; flex-direction: column; }

  .rea__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-sm);
    background: var(--sand-100);
  }
  .rea__frame :global(img) { transition: transform 900ms var(--ease-out); }
  .rea:hover .rea__frame :global(img) { transform: scale(1.04); }
  /* Voile terre cuite très léger au survol : la matière réagit. */
  .rea__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--clay-700);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-out);
    pointer-events: none;
  }
  .rea:hover .rea__frame::after { opacity: 0.06; }

  .rea__draft {
    position: absolute;
    top: var(--sp-3); left: var(--sp-3);
    z-index: 2;
    padding: 0.22rem 0.55rem;
    background: var(--alert-bg);
    border: 1px dashed var(--alert-border);
    color: var(--alert-ink);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rea__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: var(--sp-4);
    font-size: 0.72rem;
    font-weight: 660;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .rea__svc { color: var(--accent-ink); }
  .rea__sep { color: var(--border-strong); }

  .rea__title {
    margin-top: var(--sp-2);
    font-size: var(--fs-lg);
    letter-spacing: -0.025em;
  }
  .rea__title a { color: inherit; text-decoration: none; }
  .rea:hover .rea__title { color: var(--accent-ink); }

  .rea__resume {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--zinc-600);
    flex: 1;
  }

  .rea__foot {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .rea__foot :global(svg) { color: var(--clay-400); }

  /* Sur surface profonde */
  :global(.section--deep) .rea__title a, :global(.section--warm) .rea__title a { color: #fff; }
  :global(.section--deep) .rea__resume { color: var(--zinc-300); }
  :global(.section--deep) .rea__foot { border-color: var(--border-invert); }
</style>
