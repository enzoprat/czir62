---
/**
 * Emplacement photographique.
 *
 * COMPORTEMENT CLE : le composant vérifie AU MOMENT DU BUILD si le fichier
 * existe réellement dans /public. Trois conséquences :
 *
 *  1. Tant qu'une photo n'est pas fournie, on affiche un emplacement dessiné
 *     qui indique précisément quelle photo doit venir là — jamais une image
 *     cassée, jamais un rectangle gris.
 *  2. Le jour où le fichier est déposé au bon chemin, la photo apparaît
 *     automatiquement au build suivant. Aucun code à modifier : c'est
 *     exactement ce qui permet à l'entreprise d'enrichir le site elle-même.
 *  3. Les dimensions sont réservées dès maintenant, donc aucun décalage de
 *     mise en page (CLS) quand les vraies photos arrivent.
 *
 * Inventaire des photos attendues :  npm run photos
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/lib/icons';

interface Props {
  /** Chemin sous /public, ex. « /images/local/devanture.jpg » */
  src?: string;
  /** Texte alternatif réel — obligatoire, y compris pour un emplacement vide */
  alt: string;
  width?: number;
  height?: number;
  ratio?: string;
  /** Proportion appliquée sous 640 px — un portrait plein écran fait
      scroller inutilement sur téléphone. */
  ratioMobile?: string;
  /** Description de la photo attendue, affichée dans l'emplacement */
  need?: string;
  /** Image du premier écran : chargement immédiat et priorité haute */
  priority?: boolean;
  sizes?: string;
  icon?: IconName;
  caption?: string;
  class?: string;
  rounded?: boolean;
  /** Emplacement posé sur une surface profonde : la trame s'inverse. */
  tone?: 'light' | 'dark';
  /** Léger zoom de l'image au survol du conteneur parent */
  zoom?: boolean;
}

const {
  src,
  alt,
  width = 1600,
  height = 1067,
  ratio,
  ratioMobile,
  need,
  priority = false,
  sizes = '(max-width: 860px) 100vw, 50vw',
  icon = 'camera',
  caption,
  class: className,
  rounded = true,
  tone = 'light',
  zoom = false,
} = Astro.props;

/** Le fichier est-il réellement présent dans /public ? */
const chemin = src ? join(process.cwd(), 'public', src.replace(/^\//, '')) : '';
const disponible = Boolean(src) && existsSync(chemin);

/* Un jumeau .webp est servi en priorité s'il existe. Rien à déclarer : il
   suffit qu'il soit présent à côté du JPEG. */
const webp = disponible && /\.jpe?g$/i.test(src!) ? src!.replace(/\.jpe?g$/i, '.webp') : null;
const webpDispo = Boolean(webp) && existsSync(chemin.replace(/\.jpe?g$/i, '.webp'));

const aspect = ratio ?? `${width} / ${height}`;
const aspectM = ratioMobile ?? aspect;
---

<figure class:list={['ph', rounded && 'ph--rounded', tone === 'dark' && 'ph--dark', zoom && 'ph--zoom', className]} style={`--ph-ratio:${aspect};--ph-ratio-m:${aspectM}`}>
  {disponible ? (
    <picture>
      {webpDispo && <source srcset={webp} type="image/webp" />}
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="ph__img"
      />
    </picture>
  ) : (
    <div class="ph__slot" role="img" aria-label={alt}>
      <div class="ph__slot-in">
        <Icon name={icon} size={26} />
        <p class="ph__need">{need ?? alt}</p>
        <span class="ph__tag">Photo à fournir</span>
      </div>
    </div>
  )}
  {caption && <figcaption class="ph__cap">{caption}</figcaption>}
</figure>

<style>
  .ph { margin: 0; }
  .ph picture { display: block; }
  @media (max-width: 640px) {
    .ph .ph__img, .ph .ph__slot { aspect-ratio: var(--ph-ratio-m, var(--ph-ratio)); }
  }
  .ph--rounded .ph__img,
  .ph--rounded .ph__slot { border-radius: var(--r-lg); }

  .ph--rounded .ph__img, .ph--rounded .ph__slot { border-radius: var(--r-md); }
  .ph--zoom { overflow: hidden; border-radius: var(--r-md); }
  .ph--zoom .ph__img { transition: transform 900ms var(--ease-out); }
  .ph--zoom:hover .ph__img { transform: scale(1.035); }

  .ph__img {
    width: 100%;
    aspect-ratio: var(--ph-ratio);
    object-fit: cover;
    background: var(--sand-100);
  }

  /* Emplacement vide : trame de tuiles en quinconce plutôt qu'une hachure
     générique — l'attente elle-même reste dans le langage du métier. */
  .ph__slot {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: var(--ph-ratio);
    padding: var(--sp-5);
    overflow: hidden;
    border: 1px dashed var(--border-strong);
    background-color: var(--sand-50);
  }
  /* Trame de tuiles très atténuée : elle doit se deviner, pas se lire.
     Portée par ::before pour rester sous le contenu et sous contrôle. */
  .ph__slot::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--tex-tuiles);
    background-size: 48px 30px;
    opacity: .16;
    filter: invert(1);
  }
  .ph__slot-in { position: relative; }

  .ph--dark .ph__slot {
    border-color: rgba(255, 255, 255, 0.14);
    background-color: var(--zinc-800);
  }
  .ph--dark .ph__slot::before { filter: none; opacity: .07; }
  .ph--dark .ph__slot-in { color: var(--zinc-300); }
  .ph--dark .ph__need { color: var(--zinc-300); }
  .ph--dark .ph__tag { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.2); color: var(--clay-200); }
  .ph--dark .ph__slot-in :global(svg) { color: var(--clay-300); }
  .ph--dark + .ph__cap, .ph--dark .ph__cap { color: var(--zinc-400); }
  .ph__slot-in {
    display: grid;
    justify-items: center;
    gap: var(--sp-3);
    text-align: center;
    max-width: 30ch;
    color: var(--clay-600);
  }
  .ph__slot-in :global(svg) { color: var(--clay-400); }
  .ph__need { font-size: var(--fs-sm); line-height: 1.5; color: var(--clay-700); }
  .ph__tag {
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--clay-600);
    background: var(--clay-50);
    border: 1px solid var(--clay-200);
    padding: 0.22rem 0.6rem;
    border-radius: var(--r-pill);
  }

  .ph__cap {
    margin-top: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
