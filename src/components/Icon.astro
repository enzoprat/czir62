---
/**
 * Pictogramme inline. Aucune requete reseau, herite de currentColor.
 * Par defaut purement decoratif (aria-hidden) : le sens doit venir du texte.
 * Passer `label` uniquement si l'icone porte seule l'information.
 */
import { icons, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number | string;
  stroke?: number;
  label?: string;
  class?: string;
}

const { name, size = 22, stroke = 1.5, label, class: className } = Astro.props;
const body = icons[name];
if (!body) throw new Error(`[Icon] Pictogramme inconnu : « ${name} »`);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
