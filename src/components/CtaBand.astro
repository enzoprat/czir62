---
/**
 * Bande de conversion.
 *
 * C'est un moment fort, pas un pied de section : grand titre d'affiche,
 * matière visible, et un bloc d'action détaché qui appelle le geste.
 * Le libellé est toujours fourni par la page : un CTA de page « fuite » ne
 * dit pas la même chose qu'un CTA de page « ossature bois ».
 */
import Icon from '@/components/Icon.astro';
import { nap, telHref, hasPhone } from '@/config/site';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  service?: string;
  variant?: 'deep' | 'clay' | 'soft';
  trackLabel?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  text,
  primaryLabel = 'Demander un devis',
  primaryHref,
  service,
  variant = 'deep',
  trackLabel = 'cta',
  class: className,
} = Astro.props;

const href = primaryHref ?? (service ? `/devis/?prestation=${service}` : '/devis/');
const tel = telHref();
---

<section class:list={['cta', `cta--${variant}`, variant !== 'soft' && 'tex tex--tuiles', className]}>
  <div class="container cta__in">
    <div class="cta__text">
      {eyebrow && <p class="cta__eyebrow">{eyebrow}</p>}
      <p class="cta__title">{title}</p>
      {text && <p class="cta__desc">{text}</p>}
    </div>

    <div class="cta__act">
      <a href={href} class="btn btn--lg cta__btn" data-track="quote_start" data-track-label={trackLabel}>
        {primaryLabel}
      </a>

      {hasPhone() && tel && (
        <a href={tel} class="cta__tel" data-track-zone={trackLabel}>
          <span class="cta__tel-k">Ou appelez directement</span>
          <span class="cta__tel-n num"><Icon name="phone" size={17} />{nap.phone}</span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta { position: relative; padding-block: clamp(3rem, 6vw, 5.5rem); overflow: hidden; }

  .cta--deep { background: var(--deep); color: var(--text-invert); }
  .cta--clay { background: var(--clay-600); color: #fff; }
  .cta--soft { background: var(--surface-sand); border-block: 1px solid var(--border); }

  .cta__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  @media (max-width: 860px) { .cta__in { grid-template-columns: minmax(0, 1fr); } }

  .cta__eyebrow {
    font-size: 0.7rem;
    font-weight: 680;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--sp-4);
  }
  .cta--deep .cta__eyebrow { color: var(--clay-300); }
  .cta--clay .cta__eyebrow { color: rgba(255, 255, 255, 0.72); }
  .cta--soft .cta__eyebrow { color: var(--accent-ink); }

  /* Titre d'affiche : c'est ici que la page hausse la voix. */
  .cta__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw + 1rem, 3.6rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .cta--deep .cta__title, .cta--clay .cta__title { color: #fff; }
  .cta--soft .cta__title { color: var(--text-strong); }

  .cta__desc { margin-top: var(--sp-4); line-height: var(--lh-relaxed); max-width: 52ch; }
  .cta--deep .cta__desc { color: var(--zinc-300); }
  .cta--clay .cta__desc { color: rgba(255, 255, 255, 0.85); }
  .cta--soft .cta__desc { color: var(--zinc-600); }

  /* Bloc d'action détaché, aligné à droite sur grand écran */
  .cta__act { display: grid; gap: var(--sp-5); justify-items: start; }
  @media (min-width: 861px) { .cta__act { justify-items: stretch; } }

  .cta__btn { width: 100%; }
  @media (max-width: 860px) { .cta__btn { width: auto; } }
  @media (max-width: 480px) { .cta__btn { width: 100%; } }

  /* Sur fond terre cuite, le bouton s'inverse pour rester le point le plus clair */
  .cta--clay .cta__btn { background: #fff; color: var(--clay-700); box-shadow: var(--shadow-md); }
  .cta--clay .cta__btn:hover { background: var(--clay-50); }

  .cta__tel {
    display: block;
    padding-top: var(--sp-5);
    border-top: 1px solid currentColor;
    text-decoration: none;
    opacity: 0.95;
    transition: opacity var(--t-fast);
  }
  .cta__tel:hover { opacity: 1; }
  .cta--deep .cta__tel { border-color: var(--border-invert); }
  .cta--clay .cta__tel { border-color: rgba(255, 255, 255, 0.28); }
  .cta--soft .cta__tel { border-color: var(--border-strong); }

  .cta__tel-k {
    display: block;
    font-size: 0.7rem;
    font-weight: 640;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cta--deep .cta__tel-k { color: var(--zinc-400); }
  .cta--clay .cta__tel-k { color: rgba(255, 255, 255, 0.7); }
  .cta--soft .cta__tel-k { color: var(--text-muted); }

  .cta__tel-n {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.4vw + 1rem, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .cta--deep .cta__tel-n, .cta--clay .cta__tel-n { color: #fff; }
  .cta--soft .cta__tel-n { color: var(--text-strong); }
  .cta__tel-n :global(svg) { opacity: 0.7; }
</style>
