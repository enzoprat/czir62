---
/**
 * BOUTON « LAISSEZ-NOUS UN AVIS »
 *
 * Seul element du site qui sort volontairement de la palette terre cuite :
 * c'est un bouton d'action vers un service externe, et le bleu Google est
 * precisement ce qui le rend reconnaissable en une fraction de seconde.
 *
 * Le logo respecte les regles de marque de Google : le « G » quadrichrome
 * n'est ni recolore ni deforme, et il est pose sur une pastille blanche —
 * c'est la construction officielle du bouton Google sur fond bleu.
 *
 * Le composant ne rend rien tant qu'aucune URL n'est disponible : pas de
 * bouton mort sur la page.
 */
import { google } from '@/config/site';

interface Props {
  label?: string;
  /** Pleine largeur — utile en colonne laterale et sur mobile */
  block?: boolean;
  /** Zone de suivi analytique */
  trackLabel?: string;
  class?: string;
}
const { label = 'Laissez-nous un avis', block = false, trackLabel, class: klass } = Astro.props;
const href = google.writeReviewUrl;
---

{href && (
  <a
    href={href}
    class:list={['gbtn', block && 'gbtn--block', klass]}
    target="_blank"
    rel="noopener"
    data-track="google_reviews_click"
    data-track-label={trackLabel ?? 'avis-google'}
  >
    <span class="gbtn__g" aria-hidden="true">
      <svg viewBox="0 0 48 48" width="18" height="18">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
    </span>
    <span class="gbtn__t">{label}</span>
  </a>
)}

<style>
  .gbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.62rem 1.15rem 0.62rem 0.62rem;
    /* Bleu Google officiel */
    background: #4285f4;
    color: #fff;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 1;
    border-radius: var(--r-sm);
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(60, 64, 67, 0.3), 0 1px 3px 1px rgba(60, 64, 67, 0.15);
    transition: background var(--t-fast), box-shadow var(--t-fast), transform var(--t-fast);
  }
  .gbtn:hover { background: #3367d6; box-shadow: 0 1px 3px rgba(60,64,67,.3), 0 4px 8px 3px rgba(60,64,67,.15); }
  .gbtn:active { transform: translateY(1px); }
  .gbtn:focus-visible { outline: 2px solid var(--focus, #1a73e8); outline-offset: 3px; }

  /* Pastille blanche : le « G » quadrichrome doit rester sur fond clair. */
  .gbtn__g {
    display: grid;
    place-items: center;
    width: 30px; height: 30px;
    background: #fff;
    border-radius: calc(var(--r-sm) - 2px);
    flex: none;
  }
  .gbtn__t { white-space: nowrap; }

  .gbtn--block { display: flex; justify-content: center; width: 100%; }

  @media (prefers-reduced-motion: reduce) {
    .gbtn { transition: none; }
    .gbtn:active { transform: none; }
  }
</style>
