---
/**
 * Marque CZIR62.
 *
 * Le signe est le symbole de marque fourni par le client — chevron de rampant
 * à bras biseautés, panne, puis rang qui se raccourcit vers l'égout. Les
 * coordonnées sont relevées au pixel sur logo czir62.png ; le fichier
 * autonome est public/images/logo/czir62-symbole.svg.
 */
interface Props {
  variant?: 'default' | 'invert';
  class?: string;
  /** Masque la ligne descriptive (barres compactes) */
  bare?: boolean;
}
const { variant = 'default', class: className, bare = false } = Astro.props;
const ink = variant === 'invert' ? '#FFFFFF' : 'var(--zinc-900)';
const accent = variant === 'invert' ? 'var(--clay-300)' : 'var(--clay-500)';
const sub = variant === 'invert' ? 'rgba(255,255,255,.55)' : 'var(--text-muted)';
---

<span class:list={['logo', bare && 'logo--bare', className]} aria-label="CZIR62">
  <svg class="logo__mark" width="33" height="24" viewBox="0 0 544 395" aria-hidden="true">
    <path d="M272 0 542 232 501 276 272 84 43 276 2 232Z" fill={accent}/>
    <rect x="80" y="276" width="377" height="46" fill={ink}/>
    <rect x="133" y="349" width="269" height="46" fill={ink} opacity=".45"/>
  </svg>

  <span class="logo__text">
    <span class="logo__word">
      <span class="logo__name" style={`color:${ink}`}>CZIR</span><span class="logo__num" style={`color:${accent}`}>62</span>
    </span>
    {!bare && <span class="logo__sub" style={`color:${sub}`}>Entreprise générale de couverture</span>}
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.62rem; text-decoration: none; line-height: 1; }
  .logo__mark { flex: none; }
  .logo__text { display: flex; flex-direction: column; gap: 0.24rem; }
  .logo__word { display: block; white-space: nowrap; }
  .logo__name, .logo__num {
    font-family: var(--font-display);
    font-size: 1.36rem;
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .logo__sub {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.575rem;
    font-weight: 640;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .logo--bare .logo__text { gap: 0; }
  @media (max-width: 420px) {
    .logo__sub { display: none; }
    .logo__name, .logo__num { font-size: 1.26rem; }
  }
</style>
