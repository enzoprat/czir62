---
/**
 * PAGE DEVIS
 * Page de conversion pure. Un seul objectif : que le formulaire soit rempli.
 * La barre d'action mobile est masquée ici — elle recouvrirait le bouton
 * d'envoi, ce qui est exactement l'inverse de l'effet recherché.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import Icon from '@/components/Icon.astro';
import { nap, google, telHref, hasPhone, hasAddress, addressOneLine } from '@/config/site';
import { breadcrumbSchema, webPageSchema } from '@/lib/schema';

const crumbs = [{ name: 'Demander un devis' }];
const tel = telHref();
---

<BaseLayout
  title="Demander un devis — Couvreur à Béthune | CZIR62"
  description="Devis gratuit pour vos travaux de toiture à Béthune. Trois étapes, moins d'une minute, avec la possibilité de joindre des photos depuis votre téléphone."
  path="/devis/"
  hideMobileBar
  schema={[
    webPageSchema({
      path: '/devis/',
      name: 'Demander un devis — CZIR62',
      description: "Formulaire de demande de devis pour des travaux de couverture, charpente ou zinguerie à Béthune.",
    }),
    breadcrumbSchema(crumbs),
  ]}
>
  <section class="dv">
    <div class="container dv__in">
      <div class="dv__form">
        <Breadcrumbs items={crumbs} />
        <QuoteForm
          titleTag="h1"
          title="Demander un devis"
          intro="Trois étapes, moins d'une minute. Le déplacement pour établir le devis n'est pas facturé."
        />
      </div>

      <aside class="dv__side">
        <div class="dv__card">
          <h2 class="dv__card-title">Ce qui se passe ensuite</h2>
          <ol class="list-clean dv__steps">
            <li><span>1</span><div><strong>Nous vous rappelons</strong><p>Pour préciser la situation et éviter un déplacement inutile si la réponse tient en deux phrases.</p></div></li>
            <li><span>2</span><div><strong>Nous passons voir</strong><p>Sur place, gratuitement. C'est la seule façon de chiffrer sérieusement une toiture.</p></div></li>
            <li><span>3</span><div><strong>Vous recevez le devis</strong><p>Détaillé poste par poste, avec les matériaux prévus. Sans engagement de votre part.</p></div></li>
          </ol>
        </div>

        {hasPhone() && tel && (
          <div class="dv__card dv__card--call">
            <Icon name="phone" size={22} />
            <div>
              <strong>Vous préférez appeler ?</strong>
              <a href={tel} class="dv__tel" data-track-zone="page-devis">{nap.phone}</a>
              <p>Une infiltration en cours se traite mieux au téléphone qu'en formulaire.</p>
            </div>
          </div>
        )}

        <div class="dv__card dv__card--trust">
          <h2 class="dv__card-title">Pourquoi nous faire confiance</h2>
          <ul class="list-check">
            <li>Un local avec devanture à Béthune{hasAddress() ? ` — ${addressOneLine()}` : ''}</li>
            <li>Un devis détaillé, jamais un forfait opaque</li>
            <li>Aucune relance insistante si vous ne donnez pas suite</li>
            <li>Nous disons quand des travaux ne se justifient pas</li>
          </ul>
          {google.reviewsUrl && (
            <a href={google.reviewsUrl} class="link-arrow dv__reviews" target="_blank" rel="noopener"
               data-track="google_reviews_click" data-track-label="page-devis">
              Voir nos avis Google
            </a>
          )}
        </div>

        <div class="dv__card dv__card--budget">
          <h2 class="dv__card-title">Vous cherchez d'abord un ordre de grandeur ?</h2>
          <p>
            Nous ne donnons pas de prix avant d'être passés voir : ce serait un chiffre inventé.
            En revanche nous publions les fourchettes du marché et, surtout, ce qui fait
            réellement varier un devis de couvreur.
          </p>
          <a href="/prix-toiture/" class="link-arrow">Prix des travaux de toiture</a>
        </div>

        <p class="dv__rgpd">
          <Icon name="shield" size={16} />
          Vos coordonnées servent uniquement à traiter votre demande. Elles ne sont ni revendues,
          ni cédées. Voir la <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .dv {
    background: linear-gradient(180deg, var(--sand-50), var(--bone) 55%);
    padding-block: clamp(1.5rem, 4vw, 3rem) var(--sp-10);
    min-height: 60vh;
  }
  .dv__in {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 980px) { .dv__in { grid-template-columns: minmax(0, 1fr); } }

  .dv__form > :global(.bc) { margin-bottom: var(--sp-5); }

  .dv__side { display: grid; gap: var(--sp-4); position: sticky; top: calc(var(--header-h) + 1.5rem); }
  @media (max-width: 980px) { .dv__side { position: static; } }

  .dv__card {
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-xs);
  }
  .dv__card-title {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--sp-4);
  }

  .dv__steps { display: grid; gap: var(--sp-4); }
  .dv__steps li { display: flex; gap: var(--sp-3); align-items: flex-start; }
  .dv__steps li > span {
    display: grid; place-items: center;
    width: 26px; height: 26px; flex: none;
    border-radius: 50%;
    background: var(--clay-500);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .dv__steps strong { display: block; font-size: var(--fs-sm); color: var(--text-strong); }
  .dv__steps p { margin-top: 0.2rem; font-size: var(--fs-sm); color: var(--zinc-600); line-height: 1.5; }

  .dv__card--call { display: flex; gap: var(--sp-3); align-items: flex-start; background: var(--zinc-900); border-color: var(--zinc-900); }
  .dv__card--call :global(svg) { color: var(--clay-300); flex: none; margin-top: 0.2rem; }
  .dv__card--call strong { display: block; color: #fff; font-size: var(--fs-sm); }
  .dv__card--call p { margin-top: 0.35rem; font-size: var(--fs-sm); color: var(--text-invert-muted); line-height: 1.5; }
  .dv__tel {
    display: inline-block;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
  }
  .dv__tel:hover { color: var(--clay-200); }

  .dv__card--trust { background: var(--surface-sunk); }
  .dv__card--trust .list-check li { font-size: var(--fs-sm); }
  .dv__reviews { margin-top: var(--sp-4); font-size: var(--fs-sm); }

  .dv__card--budget p { margin-top: var(--sp-3); font-size: var(--fs-sm); color: var(--text-muted); }
  .dv__card--budget a { margin-top: var(--sp-4); display: inline-flex; }

  .dv__rgpd {
    display: flex; gap: 0.5rem; align-items: flex-start;
    font-size: var(--fs-xs); color: var(--text-muted); line-height: 1.6;
    padding: 0 var(--sp-2);
  }
  .dv__rgpd :global(svg) { color: var(--clay-400); flex: none; margin-top: 0.1rem; }
</style>
