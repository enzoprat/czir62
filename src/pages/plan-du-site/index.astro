---
/**
 * PLAN DU SITE (version humaine)
 * Complète le sitemap.xml : utile aux visiteurs, et vue d'ensemble de
 * l'architecture pour l'équipe.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { servicesByOrder, subServices } from '@/data/services';
import { villesByOrder } from '@/data/villes';
import { getRealisations } from '@/lib/realisations';
import { breadcrumbSchema, webPageSchema } from '@/lib/schema';

const crumbs = [{ name: 'Plan du site' }];
const realisations = await getRealisations();
---

<BaseLayout
  title="Plan du site — CZIR62"
  description="Toutes les pages du site CZIR62 : prestations, communes d'intervention, réalisations et pages pratiques."
  path="/plan-du-site/"
  noindex
  schema={[webPageSchema({ path: '/plan-du-site/', name: 'Plan du site', description: 'Ensemble des pages du site CZIR62.' }), breadcrumbSchema(crumbs)]}
>
  <section class="legal">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>Plan du site</h1>

      <div class="sm">
        <section>
          <h2>Prestations</h2>
          <ul class="list-clean sm__list">
            <li><a href="/prestations/">Toutes les prestations</a></li>
            {servicesByOrder.map((s) => <li><a href={s.url}>{s.name}</a></li>)}
          </ul>
        </section>

        <section>
          <h2>Interventions ciblées</h2>
          <ul class="list-clean sm__list">
            {subServices.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
          </ul>
        </section>

        <section>
          <h2>Zone d'intervention</h2>
          <ul class="list-clean sm__list">
            <li><a href="/zone-intervention/">Toute la zone</a></li>
            {villesByOrder.map((v) => <li><a href={v.url}>Couvreur à {v.name}</a></li>)}
          </ul>
        </section>

        <section>
          <h2>L'entreprise</h2>
          <ul class="list-clean sm__list">
            <li><a href="/entreprise/">L'entreprise</a></li>
            <li><a href="/realisations/">Réalisations</a></li>
            <li><a href="/avis/">Avis clients</a></li>
            <li><a href="/prix-toiture/">Prix des travaux de toiture</a></li>
        <li><a href="/outils/">Outils</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/devis/">Demander un devis</a></li>
          </ul>
        </section>

        {realisations.length > 0 && (
          <section>
            <h2>Réalisations</h2>
            <ul class="list-clean sm__list">
              {realisations.map((r) => (
                <li><a href={`/realisations/${r.id}/`}>{r.data.titre}</a></li>
              ))}
            </ul>
          </section>
        )}

        <section>
          <h2>Informations légales</h2>
          <ul class="list-clean sm__list">
            <li><a href="/mentions-legales/">Mentions légales</a></li>
            <li><a href="/politique-de-confidentialite/">Politique de confidentialité</a></li>
          </ul>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal { padding-block: clamp(2rem, 5vw, 3.5rem) var(--sp-10); }
  .legal h1 { margin-top: var(--sp-5); margin-bottom: var(--sp-7); }
  .sm { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-7) var(--sp-6); }
  @media (max-width: 900px) { .sm { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .sm { grid-template-columns: minmax(0, 1fr); } }
  .sm h2 {
    font-family: var(--font-sans); font-size: var(--fs-sm); font-weight: 650;
    letter-spacing: .07em; text-transform: uppercase; color: var(--text-muted);
    padding-bottom: var(--sp-3); margin-bottom: var(--sp-4); border-bottom: 1px solid var(--border);
  }
  .sm__list { display: grid; gap: 0.55rem; }
  .sm__list a { font-size: var(--fs-sm); color: var(--zinc-600); text-decoration: none; }
  .sm__list a:hover { color: var(--accent-ink); text-decoration: underline; }
</style>
