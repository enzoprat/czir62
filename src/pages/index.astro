  .pil__in::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: calc(100% + 3.5rem);
    max-height: 22rem;
    z-index: -1;
    background: linear-gradient(to top,
      rgba(14, 19, 24, 0.93) 0%,
      rgba(14, 19, 24, 0.86) 42%,
      rgba(14, 19, 24, 0.55) 72%,
      rgba(14, 19, 24, 0) 100%);
    pointer-events: none;
