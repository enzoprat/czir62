  /* ------------------------------------------------------- les piliers */
  .pil {
    display: grid;
    grid-template-columns: 1.32fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
    min-height: 30rem;
  }
  .pil__t--lead { grid-row: span 2; }
  @media (max-width: 860px) {
    .pil { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; min-height: 0; }
    .pil__t--lead { grid-row: auto; }
  }

  .pil__t {
    position: relative;
    display: block;
    min-height: 13.5rem;
    overflow: hidden;
    border-radius: 3px 3px 14px 3px;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }
  .pil__ph { position: absolute; inset: 0; z-index: -2; }
  .pil__ph img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease-out); }
  .pil__t::after {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    /* Une tuile neuve en plein soleil est presque blanche : le voile doit
       etre franc en pied, sinon le titre disparait dessus. */
    /* Voile d'ambiance seulement : la photo doit rester une photo. Le
       contraste du texte est assure separement, sous le bloc de contenu. */
    background: linear-gradient(to top, rgba(17, 22, 28, 0.42) 0%, rgba(17, 22, 28, 0.05) 62%);
    transition: background var(--t-base) var(--ease-out);
