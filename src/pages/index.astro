---
/**
 * PAGE D'ACCUEIL
 *
 * COMPOSITION — trois moments forts, le reste au service du parcours :
 *   1. le hero « devanture » : ardoise texturée, plaque émaillée, repères
 *      chiffrés intégrés, couture en pente vers la suite ;
 *   2. l'implantation en pleine largeur, la photo débordant jusqu'au bord ;
 *   3. la bande de conversion finale, terre cuite pleine.
 *
 * RYTHME DES SURFACES — aucune section ne reprend la précédente :
 *   ardoise profonde → os → sable pleine largeur → zinc technique →
 *   terre brûlée → os → sable → papier → os → terre cuite.
 *
 * ANTI-GRILLE — les prestations sont présentées en registre éditorial à
 * deux colonnes, pas en grille de cartes : dix cartes identiques, c'est
 * exactement la signature du site généré.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PhotoSlot from '@/components/PhotoSlot.astro';
import DiagnosticToiture from '@/components/DiagnosticToiture.astro';
import ZoneMap from '@/components/ZoneMap.astro';
import GoogleReviews from '@/components/GoogleReviews.astro';
import BrandsStrip from '@/components/BrandsStrip.astro';
import VitrineChantiers from '@/components/VitrineChantiers.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import CtaBand from '@/components/CtaBand.astro';
import Faq from '@/components/Faq.astro';

import { dimensions, srcset } from '@/lib/dimensions';
import { servicesByOrder, getService } from '@/data/services';
import { villes, communesDesservies, RAYON_KM } from '@/data/villes';
import { nap, google, telHref, hasPhone, hasAddress, addressOneLine, hasDirigeant, dirigeantNom } from '@/config/site';
import { webPageSchema, faqSchema, placeSchema } from '@/lib/schema';

const tel = telHref();

/* Composition de la section prestations : trois piliers photographiques,
   l'urgence isolee, le reste en registre. Les treize liens restent presents. */
const PILIERS = ['couverture', 'renovation-toiture', 'reparation-toiture'];
const piliers = PILIERS.map((x) => getService(x));
const urgence = getService('fuite-toiture');
const reste = servicesByOrder.filter((x) => !PILIERS.includes(x.slug) && x.slug !== 'fuite-toiture');

/* Repères tirés des données — aucun chiffre inventé, aucun à maintenir. */
const nbCommunes = villes.length + communesDesservies.length;
const rayonKm = RAYON_KM;

const faqItems = [
  {
    q: 'Le déplacement pour un devis est-il payant ?',
    a: "Non. Nous passons voir la toiture, nous vous disons ce que nous constatons, et le devis est établi ensuite. Chiffrer sans être monté ou sans avoir vu le bâtiment n'a pas de sens : les mauvaises surprises viennent presque toujours de là.",
  },
  {
    q: 'Intervenez-vous pour une petite réparation, ou seulement pour de gros chantiers ?',
    a: "Les deux. Une tuile déplacée, un solin fissuré, une gouttière descendue : ce sont des interventions courtes que nous prenons, parce qu'elles évitent souvent un chantier bien plus lourd deux ans plus tard. Nous regroupons ces petites demandes par secteur, ce qui explique qu'un délai puisse être annoncé plutôt qu'un passage immédiat.",
  },
  {
    q: 'Comment savoir si ma toiture doit être refaite ou simplement réparée ?',
    a: "Cela dépend de l'état réel des matériaux et des points singuliers, pas de l'âge. Une couverture ancienne mais saine peut ne demander qu'une reprise des faîtages et des rives. À l'inverse, une toiture plus récente peut poser problème si les raccords ont été mal traités. C'est ce que la visite permet de trancher.",
  },
  {
    q: 'Dans quelles communes intervenez-vous ?',
    a: "Depuis notre local de Béthune, nous couvrons le bassin béthunois : Beuvry, Bruay-la-Buissière, Nœux-les-Mines, Barlin, Lillers, Auchel, ainsi que Bully-les-Mines, Liévin et Lens. Si votre commune n'est pas dans la liste, appelez-nous : nous vous dirons franchement si nous pouvons intervenir.",
  },
];

const etapes = [
  { n: '01', t: 'Vous décrivez', d: "Par téléphone ou en ligne. Une photo du plafond taché ou du versant concerné fait souvent gagner un passage entier." },
  { n: '02', t: 'Nous montons voir', d: "Rien ne remplace le fait de monter, ou au minimum de regarder depuis les combles. C'est là que se distingue un désordre localisé d'un problème d'ensemble." },
  { n: '03', t: 'Le devis, poste par poste', d: "Avec les matériaux prévus et ce qui est exclu. Vous devez pouvoir comprendre ce que vous payez avant de vous engager." },
  { n: '04', t: 'Le chantier', d: "Protection des abords, évacuation des gravats vers une filière adaptée, terrain rendu propre. Cela devrait aller de soi." },
];
---

<BaseLayout
  title="Couvreur à Béthune (62400) — CZIR62, artisan depuis 1925"
  description="Entreprise familiale de couverture à Béthune depuis 1925 : rénovation de toiture, réparation, fuite, zinguerie, charpente, démoussage. Devis gratuit."
  path="/"
  ogImage="/images/accueil/couvreur-bethune-czir62.jpg"
  schema={[
    webPageSchema({ path: '/', name: 'Couvreur à Béthune — CZIR62', description: "Entreprise générale de couverture installée à Béthune : couverture, rénovation de toiture, zinguerie, charpente." }),
    placeSchema('/images/local/devanture-czir62-bethune.jpg'),
    faqSchema(faqItems),
  ]}
>
  <!-- ═══════════════════ 1 · HERO — LA DEVANTURE ═══════════════════════ -->
  <section class="hero tex tex--tuiles">
    <div class="container hero__in">
      <div class="hero__text">
        <p class="hero__kicker">
          <span class="hero__dot" aria-hidden="true"></span>
          Entreprise générale de couverture · Béthune (62)
        </p>

        <h1 class="hero__title">Couvreur <span class="hero__br">à Béthune</span></h1>

        <p class="hero__lede">
          Couverture, rénovation de toiture, zinguerie et charpente
          à Béthune et dans les environs.
        </p>

        <div class="hero__cta">
          <a href="/devis/" class="btn btn--lg btn--go" data-track="quote_start" data-track-label="hero-accueil">
            Demander mon devis
          </a>
          {hasPhone() && tel ? (
            <a href={tel} class="btn btn--on-dark btn--lg num btn--phone" data-track-zone="hero-accueil">
              <Icon name="phone" size={18} /> Appeler CZIR62
            </a>
          ) : (
            <a href="/contact/" class="btn btn--on-dark btn--lg">Nous contacter</a>
          )}
        </div>
      </div>

      <div class="hero__media">
        <PhotoSlot
          src="/images/accueil/couvreur-bethune-czir62.jpg"
          alt="Couvreur CZIR62 sur un rampant liteauné, avant la pose de la couverture"
          need="Photo verticale d'un chantier de couverture terminé."
          ratio="4 / 5"
          ratioMobile="3 / 2"
          priority
          icon="roof"
          tone="dark"
          sizes="(max-width: 900px) 100vw, 42vw"
        />

        <!-- La plaque : l'objet signature du site -->
        <div class="hero__plaque plaque">
          <p class="hero__plaque-k">Entreprise générale de couverture</p>
          <p class="hero__plaque-n">CZIR<span>62</span></p>
          <div class="hero__plaque-rule" aria-hidden="true"></div>
          <p class="hero__plaque-a">
            {hasAddress() ? addressOneLine() : 'Local avec devanture — Béthune (62)'}
          </p>
          {hasPhone() && tel && <a class="hero__plaque-t num" href={tel} data-track-zone="plaque-hero">{nap.phone}</a>}
        </div>
      </div>
    </div>

    <!-- Repères, intégrés au hero plutôt qu'en bandeau séparé -->
    <div class="container">
      <ul class="list-clean hero__stats stats">
        <li class="stat">
          <span class="stat__v num">{servicesByOrder.length}</span>
          <span class="stat__k">prestations, de la tuile au chantier complet</span>
        </li>
        <li class="stat">
          <span class="stat__v num">{nbCommunes}</span>
          <span class="stat__k">communes desservies</span>
        </li>
        <li class="stat">
          <span class="stat__v num">{rayonKm}<em>km</em></span>
          <span class="stat__k">de rayon, jusqu’à la métropole lilloise</span>
        </li>
        <li class="stat">
          <span class="stat__v">Gratuit</span>
          <span class="stat__k">le déplacement pour le devis</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════ 2 · PRESTATIONS — REGISTRE ÉDITORIAL ══════════════ -->
  <section class="section svc seam-top--rev">
    <div class="container">
      <div class="head-split svc__head">
        <div>
          <p class="eyebrow">Prestations</p>
          <h2 class="svc__h2">Ce que nous faisons,<br />concrètement</h2>
        </div>
        <p class="lede">
          Une toiture pose rarement un seul problème à la fois : une infiltration renvoie souvent
          à un solin, une rénovation à l'état de la charpente. Chaque prestation a sa page, avec
          ce qu'il faut savoir avant de décider.
        </p>
      </div>

      {/* Trois piliers, en tuiles photographiques de tailles inégales : le
          métier de base occupe la place qu'il occupe dans l'activité. */}
      <div class="pil">
        {piliers.map((s, i) => (
          <a href={s.url} class:list={['pil__t', i === 0 && 'pil__t--lead', 'reveal']}>
            <span class="pil__ph">
              <img src={`/images/services/${s.slug}-czir62.jpg`} alt="" loading="lazy" decoding="async"
                   srcset={srcset(`/images/services/${s.slug}-czir62.jpg`)?.jpeg}
                   width={dimensions(`/images/services/${s.slug}-czir62.jpg`)?.width}
                   height={dimensions(`/images/services/${s.slug}-czir62.jpg`)?.height}
                   sizes="(max-width: 860px) 100vw, 50vw" />
            </span>
            <span class="pil__in">
              <span class="pil__ico"><Icon name={s.icon} size={20} /></span>
              <strong>{s.name}</strong>
              <em>{s.cardText}</em>
              <span class="pil__go" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>

      {/* L'urgence ne se range pas dans une grille avec les autres. */}
      <a href={urgence.url} class="urg reveal">
        <span class="urg__k"><Icon name="alert" size={19} /> Urgence</span>
        <span class="urg__t">
          <strong>Une infiltration en cours&nbsp;?</strong>
          <em>{urgence.cardText}</em>
        </span>
        <span class="urg__go" aria-hidden="true">→</span>
      </a>

      {/* Le reste en registre serré : lisible, scannable, sans prétendre que
          neuf prestations valent chacune une tuile photographique. */}
      <ol class="list-clean svc__rest">
        {reste.map((s) => (
          <li>
            <a href={s.url} class="svc__link">
              <span class="svc__ico"><Icon name={s.icon} size={18} /></span>
              <span class="svc__body">
                <strong>{s.name}</strong>
                <em>{s.cardText.split(/[:.]/)[0]}</em>
              </span>
              <span class="svc__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>

      <p class="svc__all">
        <a href="/prestations/" class="link-arrow">Les {servicesByOrder.length} prestations en détail</a>
      </p>
    </div>
  </section>

  <!-- ═══════════ 3 · IMPLANTATION — PLEINE LARGEUR, PHOTO À BORD ═══════ -->
  <section class="impl">
    <div class="impl__grid">
      <div class="impl__media reveal reveal--mask">
        <PhotoSlot
          src="/images/local/devanture-czir62-bethune.jpg"
          alt="Devanture du local CZIR62 à Béthune, entreprise générale de couverture"
          need="LA photo importante : la devanture du local, prise de face, en journée, enseigne CZIR62 lisible."
          ratio="4 / 3"
          icon="storefront"
          rounded={false}
          zoom
          sizes="(max-width: 900px) 100vw, 52vw"
        />
      </div>

      <div class="impl__text">
        <p class="eyebrow">Implantation</p>
        <h2>Une adresse,<br />pas une boîte aux lettres</h2>

        <div class="prose prose--lead impl__prose">
          <p>
            Dans le bâtiment, et particulièrement en couverture, beaucoup d'entreprises
            se créent et disparaissent en l'espace d'une saison.
          </p>
          <p>
            Un local avec une devanture n'est pas un argument commercial : c'est un fait
            vérifiable. Vous pouvez situer l'entreprise, passer devant, et savoir où revenir
            si quelque chose doit être repris six mois plus tard.
          </p>
        </div>

        <ul class="list-clean impl__facts">
          <li><Icon name="storefront" size={17} /><span>Une devanture au nom de CZIR62, à Béthune</span></li>
          <li><Icon name="check" size={17} /><span>Les mêmes coordonnées ici, sur la fiche Google et sur les devis</span></li>
          <li><Icon name="pin" size={17} /><span>Un secteur resserré, que nous connaissons réellement</span></li>
        </ul>

        <div class="btn-row impl__btns">
          <a href="/entreprise/" class="btn btn--ghost">Découvrir l'entreprise</a>
          {google.directionsUrl && (
            <a href={google.directionsUrl} class="btn btn--ghost" target="_blank" rel="noopener"
               data-track="directions_click" data-track-label="accueil-implantation">
              <Icon name="route" size={17} /> Itinéraire
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 4 · DIAGNOSTIC — SURFACE TECHNIQUE ════════════════ -->
  <section class="section section--zinc tex tex--plan">
    <div class="container">
      <DiagnosticToiture />
    </div>
  </section>

  <!-- ═════════════ 5 · DÉROULEMENT — TERRE BRÛLÉE, FRISE ═══════════════ -->
  <section class="section section--warm proc tex tex--tuiles">
    <div class="container">
      <div class="head-split">
        <div>
          <p class="eyebrow">Déroulement</p>
          <h2>Comment se passe<br />une intervention</h2>
        </div>
        <p class="lede">
          Quatre étapes, sans zone d'ombre. Vous devez savoir à chaque moment ce qui a
          été constaté, ce qui est prévu, et pourquoi.
        </p>
      </div>

      <ol class="list-clean frise">
        {etapes.map((e) => (
          <li class="frise__step reveal">
            <span class="frise__n num">{e.n}</span>
            <span class="frise__bullet" aria-hidden="true"></span>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </li>
        ))}
      </ol>

      <aside class="soust reveal">
        <p class="soust__k">Ce qui ne se voit pas sur une photo de chantier</p>
        <ul class="list-clean soust__l">
          <li>
            <span class="soust__n num">{nap.familleDepuis}</span>
            <span><strong>Entreprise familiale</strong>{hasDirigeant() ? `${dirigeantNom()}, qui la dirige aujourd'hui, exerce depuis ${nap.experienceYears} ans.` : `Le couvreur qui la dirige aujourd'hui exerce depuis ${nap.experienceYears} ans.`}</span>
          </li>
          <li>
            <span class="soust__n"><Icon name="shield" size={20} /></span>
            <span><strong>Aucune sous-traitance</strong>L'équipe qui chiffre est celle qui monte sur le toit.</span>
          </li>
          <li>
            <span class="soust__n"><Icon name="ruler" size={20} /></span>
            <span><strong>Architecte pour l'urbanisme</strong>Réhaussement, agrandissement, autorisation en mairie.</span>
          </li>
        </ul>
        <a href="/entreprise/" class="link-arrow soust__more">Comment nous travaillons</a>
      </aside>
    </div>
  </section>

  <!-- ═══════════════ 6 · RÉALISATIONS — VITRINE + AVANT/APRÈS ═════════ -->
  <section class="section">
    <div class="container">
      <VitrineChantiers
        intro="Une toiture finie se ressemble d'un chantier à l'autre. Tout se joue avant : sur le support, sur l'écran, sur le liteaunage. Ces photos montrent ce moment-là."
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="head-split">
        <div>
          <p class="eyebrow">Avant / après</p>
          <h2>La même maison, à six semaines d'intervalle</h2>
        </div>
        <p class="lede">
          Faites glisser la poignée. À gauche la toiture d'origine, à droite la couverture neuve —
          même point de vue, même cadrage.
        </p>
      </div>
      <div class="ba-home">
        <BeforeAfter
          avant={{ src: '/images/realisations/renovation-toiture-avant-czir62.jpg', alt: "Toiture avant rénovation, couverture d'origine dégradée" }}
          apres={{ src: '/images/realisations/renovation-toiture-apres-czir62.jpg', alt: 'La même toiture après rénovation complète, couverture neuve' }}
          ratio="4 / 5"
          caption="Rénovation complète de couverture"
        />
      </div>
      <p class="ba-home__more">
        <a href="/renovation-toiture/" class="link-arrow">Comment se déroule une rénovation de toiture</a>
      </p>
    </div>
  </section>

  <ZoneMap />

  <GoogleReviews intro="Les avis publiés sur notre fiche Google Business Profile, sans sélection ni retouche." />

  <BrandsStrip />

  <!-- ══════════════════════════ 7 · FAQ ════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <Faq
        items={faqItems}
        title="Les questions qu'on nous pose le plus souvent"
        intro="Chaque prestation a sa propre FAQ, plus détaillée, sur sa page dédiée."
      />
    </div>
  </section>

  <CtaBand
    variant="clay"
    eyebrow="Devis gratuit"
    title="Parlons de votre toiture"
    text="Décrivez la situation en quelques mots. Nous rappelons pour préciser, puis nous passons voir avant de chiffrer."
    primaryLabel="Demander mon devis"
    trackLabel="accueil-final"
  />
</BaseLayout>

<style>
  .ba-home { max-width: 34rem; margin-top: var(--sp-8); }
  .ba-home__more { margin-top: var(--sp-6); }

  /* ------------------------------------------------- sans sous-traitance */
  /* Trois preuves plutot qu'un paragraphe : chacune tient en une ligne et
     se lit sans effort, ce qu'un bloc de texte dans un encart gris ne
     permettait pas. */
  .soust {
    margin-top: var(--sp-9);
    padding: var(--sp-6) var(--sp-7);
    background: rgba(255, 255, 255, 0.6);
    border-top: 2px solid var(--clay-500);
    backdrop-filter: blur(3px);
  }
  .soust__k {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--clay-700);
  }
  .soust__l {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-7);
    margin-top: var(--sp-6);
  }
  @media (max-width: 860px) { .soust__l { grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); } }
  .soust__l li { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); align-items: start; gap: var(--sp-4); }
  .soust__n {
    display: grid; place-items: center;
    min-height: 2.4rem;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--clay-600);
    border-right: 1px solid var(--rule);
    padding-right: var(--sp-3);
  }
  .soust__l strong { display: block; font-weight: 640; line-height: 1.3; }
  .soust__l span span, .soust__l li > span:last-child {
    font-size: var(--fs-sm); color: var(--text-muted); line-height: var(--lh-snug);
  }
  .soust__more { margin-top: var(--sp-6); }

  /* ═══════════════════════════ 1 · HERO ════════════════════════════════ */
  .hero {
    position: relative;
    background: var(--zinc-900);
    color: var(--text-invert);
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
    /* La couture est portée par la section suivante : le hero reste net. */

    /* Le halo ::after deborde de 10 % a droite : sans rognage il ajoutait
       140 px de defilement horizontal a toute la page. `clip` le contient
       sans creer de conteneur de defilement, contrairement a `hidden`. */
    overflow-x: clip;
  }
  .hero::after {
    /* Halo terre cuite très bas, côté photo : la chaleur du matériau. */
    content: '';
    position: absolute;
    inset: auto -10% -30% 45%;
    height: 70%;
    background: radial-gradient(60% 60% at 50% 50%, rgba(178, 94, 49, 0.22), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  @media (max-width: 900px) {
    .hero__in { grid-template-columns: minmax(0, 1fr); gap: var(--sp-7); }
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--clay-300);
  }
  .hero__dot { width: 6px; height: 6px; background: var(--clay-400); flex: none; }

  .hero__title {
    margin-top: var(--sp-5);
    font-family: var(--font-display);
    font-size: var(--fs-6xl);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: #fff;
  }
  /* Remplace un <br /> : un lecteur d'ecran et les extracteurs de texte
     collent les mots de part et d'autre d'un <br />, ce qui donnait
     « Couvreurà Bethune ». Le saut de ligne reste purement visuel. */
  .hero__br { display: block; }

  .hero__lede {
    margin-top: var(--sp-5);
    font-size: var(--fs-xl);
    line-height: 1.45;
    letter-spacing: -0.018em;
    color: var(--zinc-300);
    max-width: 26ch;
    text-wrap: pretty;
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-7); }
  @media (max-width: 480px) {
    .hero__cta { flex-direction: column; align-items: stretch; }
    .hero__cta .btn { width: 100%; }
  }

  .hero__media { position: relative; }

  /* La plaque, vissée sur le bord bas-gauche de la photo */
  .hero__plaque {
    position: absolute;
    left: -2.5rem;
    bottom: -2rem;
    width: min(20rem, 82%);
    padding: var(--sp-5) var(--sp-6);
  }
  .hero__plaque-k {
    font-size: 0.6rem;
    font-weight: 660;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--zinc-400);
  }
