      rgba(94, 41, 16, 0.58) 0%,
      rgba(17, 22, 28, 0.10) 66%
    );
  }
  .pil__t:focus-visible { outline: 2px solid var(--clay-300); outline-offset: 3px; }

  /* Voile serre, cale sur le bloc de texte : il descend d'un tiers au-dessus
