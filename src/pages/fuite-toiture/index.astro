---
/**
 * PAGE FUITE DE TOITURE
 * Intention : urgence et problème. Le visiteur a de l'eau chez lui, ou une
 * trace qui l'inquiète. Il ne veut pas découvrir une entreprise, il veut
 * comprendre et être pris en charge.
 *
 * Structure propre à cette page :
 *  - hero sombre, ton direct, action d'appel immédiate
 *  - « que faire maintenant » placé AVANT toute présentation
 *  - l'assistant infiltration très haut dans la page
 *  - une explication schématisée du trajet de l'eau, qui répond à la question
 *    que tout le monde se pose : pourquoi la fuite n'est pas au-dessus de la tache
 *  - un inventaire des points d'entrée réels, avec leur symptôme caractéristique
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import AssistantFuite from '@/components/AssistantFuite.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import RelatedServices from '@/components/RelatedServices.astro';
import CityLinks from '@/components/CityLinks.astro';
import RealisationsBlock from '@/components/RealisationsBlock.astro';

import { getService } from '@/data/services';
import { telHref, hasPhone, nap } from '@/config/site';
import { realisationsForService } from '@/lib/realisations';
import { breadcrumbSchema, serviceSchema, faqSchema, webPageSchema } from '@/lib/schema';

const service = getService('fuite-toiture');
const tel = telHref();
const realisations = await realisationsForService('fuite-toiture', 3);
const crumbs = [{ name: 'Prestations', url: '/prestations/' }, { name: 'Fuite de toiture' }];

/* Les points d'entree reels, avec le symptome qui les trahit */
const entrees = [
  {
    t: 'Le solin de cheminée',
    icon: 'chimney' as const,
    symptome: "Une auréole qui revient toujours au même endroit, à l'aplomb ou légèrement en aval de la souche, après chaque forte pluie.",
    cause: "La jonction entre la maçonnerie de la souche et la couverture. Le mortier se fissure, la bande d'étanchéité se décolle, ou la souche elle-même absorbe l'eau et la restitue à l'intérieur.",
  },
  {
    t: 'Le raccord de fenêtre de toit',
    icon: 'velux' as const,
    symptome: "Une trace sur l'encadrement intérieur, souvent en partie haute, ou une coulure le long du tableau.",
    cause: "Le raccord d'étanchéité périphérique, et non le vitrage. Un raccord inadapté au type de couverture, mal engravé ou vieilli laisse passer l'eau alors que la fenêtre est intacte.",
  },
  {
    t: 'Le faîtage',
    icon: 'roof' as const,
    symptome: "Des traces réparties le long de la ligne de crête, parfois sur plusieurs pièces, plutôt qu'en un point unique.",
    cause: "Un faîtage scellé au mortier qui s'est fissuré, ou des closoirs dégradés. L'eau entre par le haut et se distribue ensuite sur toute la longueur.",
  },
  {
    t: 'La noue',
    icon: 'gutter' as const,
    symptome: "Une infiltration qui n'apparaît que lors des pluies fortes ou prolongées, jamais pendant une averse légère.",
    cause: "La noue rassemble l'eau de deux versants. Sous-dimensionnée, encombrée ou percée, elle déborde sous la couverture au moment où le débit augmente.",
  },
  {
    t: 'Une tuile cassée ou déplacée',
    icon: 'repair' as const,
    symptome: "Une tache localisée, apparue brutalement, souvent après un épisode venteux.",
    cause: "Le cas le plus simple — et le plus fréquent. Sans écran sous-toiture, l'eau tombe directement sur le plancher des combles.",
  },
  {
    t: 'La rive ou le débord',
    icon: 'cladding' as const,
    symptome: "Une trace le long d'un mur pignon, ou une humidité en haut de mur plutôt qu'au plafond.",
    cause: "Les tuiles de rive sont les plus exposées au vent. Un scellement dégradé laisse l'eau contourner la couverture par le côté.",
  },
  {
    t: 'La gouttière qui refoule',
    icon: 'gutter' as const,
    symptome: "De l'eau qui ruisselle le long de la façade, ou une humidité en bas de rampant.",
    cause: "Une gouttière bouchée ou sans pente met l'eau en charge. Elle refoule alors sous les premières tuiles, à contresens de l'écoulement prévu.",
  },
  {
    t: "L'écran sous-toiture absent ou percé",
    icon: 'tile' as const,
    symptome: "Des infiltrations diffuses par vent de pluie, sans désordre visible sur la couverture.",
    cause: "Beaucoup de toitures anciennes n'ont aucune seconde barrière. La pluie poussée horizontalement passe entre les tuiles et n'est arrêtée par rien.",
  },
];

const faqItems = [
  {
    q: "Comment savoir d'où vient une fuite de toiture ?",
    a: "En remontant le trajet de l'eau, pas en regardant au-dessus de la tache. L'eau entre par un point haut, circule le long d'un chevron ou d'une panne — parfois sur plusieurs mètres — puis tombe là où quelque chose l'arrête. La recherche se fait donc depuis les combles quand c'est possible, en repérant les traces fraîches sur les bois, puis sur la toiture au niveau des points singuliers situés en amont.",
  },
  {
    q: 'Une fuite nécessite-t-elle forcément de refaire toute la toiture ?',
    a: "Non, et c'est même rarement le cas. La grande majorité des infiltrations viennent d'un point singulier — solin, raccord de fenêtre de toit, faîtage, noue — ou d'une tuile déplacée, et se traitent ponctuellement. Une reprise complète ne se justifie que si la couverture est globalement en fin de vie, ce qui est une autre question. Nous vous disons dans quel cas vous êtes.",
  },
  {
    q: 'Une infiltration autour d’un Velux peut-elle être réparée ?',
    a: "Oui, dans la plupart des cas, sans remplacer la fenêtre. Le problème vient presque toujours du raccord d'étanchéité périphérique : il se dépose et se reprend avec un raccord adapté au type de couverture. Le remplacement de la fenêtre ne se pose que si le dormant ou le vitrage sont eux-mêmes en cause.",
  },
  {
    q: 'Ma toiture fuit seulement quand il pleut beaucoup, est-ce grave ?',
    a: "C'est une information précieuse plutôt qu'un signe de gravité. Une fuite qui n'apparaît qu'au-delà d'un certain débit oriente vers une noue, un chéneau ou une gouttière qui se met en charge. Une fuite qui n'apparaît que par vent d'une direction précise oriente vers une rive ou un défaut d'écran. Notez ces conditions, elles font gagner du temps.",
  },
  {
    q: 'Que faire en attendant votre passage ?',
    a: "Protégez ce qui peut l'être, placez un récipient sous l'écoulement, et coupez l'électricité de la zone si l'eau approche d'un point lumineux ou d'une prise. Ne montez pas sur le toit : une toiture mouillée est glissante, et une tuile ancienne casse sous le pied. Si vous pouvez accéder aux combles sans danger, une photo des traces fraîches sur les bois nous aide beaucoup.",
  },
  {
    q: 'Dois-je déclarer la fuite à mon assurance avant de faire réparer ?',
    a: "Déclarez d'abord, réparez ensuite — sauf si l'eau entre activement, auquel cas la mise en sécurité prime et l'assureur ne vous le reprochera pas. Dans tous les cas, photographiez avant d'intervenir : une bâche posée efface la preuve du désordre. Nous fournissons un devis détaillé et des photos du point d'entrée, ce qui constitue le dossier technique que votre assureur demandera. La décision d'indemnisation lui appartient, pas à nous.",
  },
  {
    q: 'Une infiltration peut-elle venir d’ailleurs que de la toiture ?',
    a: "Oui, et c'est une confusion fréquente. Une remontée d'humidité par capillarité, une fuite de canalisation encastrée ou une condensation liée à une ventilation insuffisante produisent des traces qui ressemblent à une infiltration. L'indice le plus fiable reste la corrélation avec la pluie : si la trace évolue indépendamment de la météo, la toiture n'est probablement pas en cause.",
  },
];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  path={service.url}
  ogImage="/images/services/fuite-toiture-czir62.jpg"
  pageEvent="service_view"
  pageSlug={service.slug}
  pageLabel={service.name}
  schema={[
    webPageSchema({ path: service.url, name: service.metaTitle, description: service.metaDescription }),
    breadcrumbSchema(crumbs),
    serviceSchema(service),
    faqSchema(faqItems),
  ]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Fuite & infiltration"
    title="Fuite de toiture à Béthune : recherche et réparation"
    lede="Une auréole au plafond, une trace qui revient après chaque pluie, de l'eau qui goutte dans les combles. Nous cherchons le point d'entrée réel — qui se trouve rarement au-dessus de la tache — puis nous réparons."
    photo="/images/services/fuite-toiture-czir62.jpg"
    photoAlt="Souche de cheminée sur une toiture en tuiles : le raccord le plus fréquemment en cause dans une infiltration"
    photoNeed="Idéalement : photo d'une infiltration constatée — auréole au plafond ou trace fraîche sur un chevron."
    icon="leak"
    variant="deep"
    chips={['Recherche du point d’entrée', 'Réparation des points singuliers', 'Secteur de Béthune']}
  >
    <Fragment slot="actions">
      {hasPhone() && tel ? (
        <a href={tel} class="btn btn--lg" data-track-zone="hero-fuite">
          <Icon name="phone" size={19} /> Appeler {nap.phone}
        </a>
      ) : (
        <a href="#assistant" class="btn btn--lg">Signaler une fuite</a>
      )}
      <a href="#assistant" class="btn btn--on-dark btn--lg">Décrire la situation</a>
    </Fragment>
  </PageHero>

  <!-- ============================================ QUE FAIRE MAINTENANT == -->
  <section class="now">
    <div class="container">
      <h2 class="now__title">Si l’eau passe en ce moment</h2>
      <ol class="list-clean now__steps">
        <li>
          <span class="now__n">1</span>
          <div>
            <strong>Coupez l’électricité de la zone</strong>
            <p>Si l'eau approche d'un point lumineux, d'une prise ou d'un tableau, coupez le circuit concerné avant toute autre chose.</p>
          </div>
        </li>
        <li>
          <span class="now__n">2</span>
          <div>
            <strong>Recueillez l’eau et dégagez</strong>
            <p>Un récipient sous l'écoulement, et écartez meubles et objets. Si le plafond gonfle, percez volontairement un petit trou au point bas pour éviter qu'il ne cède d'un coup.</p>
          </div>
        </li>
        <li>
          <span class="now__n">3</span>
          <div>
            <strong>Ne montez pas sur le toit</strong>
            <p>Une couverture mouillée est glissante et une tuile ancienne casse sous le pied. Vous risqueriez d'aggraver la fuite en plus de vous mettre en danger.</p>
          </div>
        </li>
      </ol>
      {hasPhone() && tel && (
        <a href={tel} class="btn now__call" data-track-zone="urgence-fuite">
          <Icon name="phone" size={19} /> Appeler CZIR62 — {nap.phone}
        </a>
      )}
    </div>
  </section>

  <!-- ================================================ ASSISTANT ========= -->
  <section class="section">
    <div class="container">
      <AssistantFuite />
    </div>
  </section>

  <!-- ============================================= TRAJET DE L'EAU ====== -->
  <section class="section section--alt">
    <div class="container">
      <div class="trajet">
        <div class="trajet__text">
          <p class="eyebrow">Ce qu’il faut comprendre</p>
          <h2>La fuite n’est presque jamais au-dessus de la tache</h2>
          <div class="prose">
            <p>
              C'est la source de la plupart des malentendus. L'eau entre par un point haut de la
              toiture, puis elle <strong>suit la pente du bois</strong> : elle court le long d'un
              chevron ou d'une panne, parfois sur plusieurs mètres, jusqu'à rencontrer un obstacle
              — un assemblage, un about de chevron, un point bas de l'isolant. C'est là qu'elle
              tombe, et c'est là que la tache apparaît.
            </p>
            <p>
              Conséquence pratique : chercher la fuite à la verticale de la trace mène presque
              toujours à une conclusion fausse. On peut y remplacer trois tuiles parfaitement
              saines et voir l'infiltration revenir à la pluie suivante.
            </p>
            <p>
              C'est aussi pourquoi nous commençons par les combles quand c'est possible.
              Une trace fraîche sur un chevron, un point de lumière visible depuis l'intérieur ou
              un isolant tassé et humide localisent l'entrée bien mieux qu'une tache au plafond.
            </p>
          </div>
        </div>

        <!-- Schema du trajet : dessine pour cette page -->
        <div class="trajet__draw">
          <svg viewBox="0 0 420 300" role="img" aria-label="Schéma : l'eau entre par un point haut de la toiture, circule le long d'un chevron, puis tombe plus bas où la tache apparaît">
            <path d="M40 250 L210 70 L380 250" fill="none" stroke="var(--wood-400)" stroke-width="8" stroke-linejoin="round"/>
            <path d="M60 250 L210 90" stroke="var(--wood-400)" stroke-width="5" stroke-linecap="round"/>
            <path d="M110 250 h200" stroke="var(--zinc-400, #8894a3)" stroke-width="6" stroke-linecap="round" opacity=".5"/>
            <text x="330" y="243" class="tj-lbl" text-anchor="end">plafond</text>

            <!-- point d'entree -->
            <circle cx="196" cy="103" r="11" fill="var(--clay-500)"/>
            <text x="215" y="99" class="tj-lbl tj-lbl--strong">point d'entrée réel</text>

            <!-- trajet de l'eau -->
            <path d="M196 108 Q170 150 140 195 Q126 218 122 244"
                  fill="none" stroke="#3E7CB1" stroke-width="3.5" stroke-dasharray="8 6" stroke-linecap="round"/>
            <polygon points="122,252 117,240 127,240" fill="#3E7CB1"/>

            <!-- tache -->
            <ellipse cx="122" cy="258" rx="30" ry="7" fill="#3E7CB1" opacity=".25"/>
            <text x="122" y="284" class="tj-lbl" text-anchor="middle">la tache visible</text>

            <text x="150" y="175" class="tj-lbl tj-lbl--water" transform="rotate(56 150 175)">l'eau suit le bois</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================== POINTS D'ENTREE ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Origines</p>
        <h2>Les huit points par lesquels l’eau entre</h2>
        <p class="lede lede--wide">
          Dans l'immense majorité des cas, l'infiltration ne vient pas du milieu du versant
          mais d'un endroit où la couverture s'interrompt, change de direction ou rencontre
          autre chose. Voici les symptômes qui les distinguent.
        </p>
      </div>

      <div class="entrees">
        {entrees.map((e) => (
          <article class="entrees__card reveal">
            <div class="entrees__head">
              <span class="entrees__ico"><Icon name={e.icon} size={20} /></span>
              <h3>{e.t}</h3>
            </div>
            <p class="entrees__sym"><span>Ce que vous voyez</span>{e.symptome}</p>
            <p class="entrees__cause"><span>Ce qui se passe</span>{e.cause}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ RECHERCHE DE FUITE ==== -->
  <section class="section section--deep" id="recherche">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Méthode</p>
        <h2>Comment nous cherchons une fuite</h2>
        <p class="lede lede--wide">
          Une recherche de fuite se mène dans un ordre précis. Sauter une étape, c'est réparer
          au hasard et revenir dans trois mois.
        </p>
      </div>

      <ol class="list-clean methode">
        <li>
          <span class="methode__n">01</span>
          <h3>Vos observations</h3>
          <p>Depuis quand, à quelle fréquence, par quel temps. Une fuite qui n'apparaît que par vent d'ouest ne se cherche pas au même endroit qu'une fuite systématique.</p>
        </li>
        <li>
          <span class="methode__n">02</span>
          <h3>L’intérieur d’abord</h3>
          <p>Les combles quand ils sont accessibles : traces fraîches sur les bois, isolant humide, jour visible. C'est l'étape la plus rentable et la plus souvent négligée.</p>
        </li>
        <li>
          <span class="methode__n">03</span>
          <h3>Les points singuliers en amont</h3>
          <p>On remonte la pente depuis le point de chute : solins, raccords, noues, faîtage, abords de fenêtres de toit situés au-dessus.</p>
        </li>
        <li>
          <span class="methode__n">04</span>
          <h3>La mise en eau si nécessaire</h3>
          <p>Quand rien n'est concluant, on arrose méthodiquement zone par zone, en partant du bas, jusqu'à reproduire le phénomène. C'est long, mais c'est la seule méthode qui donne une certitude.</p>
        </li>
        <li>
          <span class="methode__n">05</span>
          <h3>Le constat, puis la réparation</h3>
          <p>Nous vous montrons ce que nous avons trouvé, en photo si l'accès est difficile, avant d'intervenir. Vous devez comprendre ce que vous payez.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- =============================================== ASSURANCE ========= -->
  <section class="section section--alt" id="assurance">
    <div class="container">
      <div class="head-split">
        <div>
          <p class="eyebrow">Assurance</p>
          <h2>« Est-ce que mon assurance va payer ? »</h2>
        </div>
        <p class="lede">
          C'est la première question qu'on nous pose, et la réponse surprend presque toujours.
          Votre contrat multirisque habitation raisonne en <em>conséquences</em> et en
          <em>causes</em> : il traite très bien les premières, et refuse en principe les secondes.
        </p>
      </div>

      <div class="assur">
        <article class="assur__cas assur__cas--oui">
          <p class="assur__k">Généralement pris en charge</p>
          <h3>Les dégâts à l'intérieur</h3>
          <p>
            Le plafond taché, la peinture cloquée, le parquet gondolé, le mobilier abîmé : c'est
            la garantie dégât des eaux qui joue, sous réserve de votre franchise et d'un état des
            lieux. C'est la part la plus visible du sinistre, et souvent la plus coûteuse.
          </p>
        </article>

        <article class="assur__cas assur__cas--non">
          <p class="assur__k">Généralement exclu</p>
          <h3>La réparation de la toiture elle-même</h3>
          <p>
            L'assurance indemnise les conséquences du sinistre, pas ce qui l'a provoqué. La tuile
            fendue, le solin descellé, la noue percée restent à votre charge : ce sont des
            réparations d'entretien, pas un aléa. Aucun contrat standard ne les couvre.
          </p>
        </article>

        <article class="assur__cas assur__cas--peut">
          <p class="assur__k">Variable selon le contrat</p>
          <h3>Les frais de recherche de fuite</h3>
          <p>
            Beaucoup de contrats prévoient une garantie « recherche de fuite ». Elle vise
            généralement les investigations menées à l'intérieur du logement — sondages, démontages
            —, plus rarement une recherche conduite sur la toiture. Lisez la clause avant
            d'engager : elle se trouve à l'article dégât des eaux.
          </p>
        </article>

        <article class="assur__cas assur__cas--oui">
          <p class="assur__k">L'exception qui change tout</p>
          <h3>L'événement climatique</h3>
          <p>
            Tempête, grêle, poids de la neige : là, la garantie tempête peut couvrir la toiture
            elle-même, pas seulement l'intérieur. Les délais de déclaration sont courts, souvent de
            l'ordre de cinq jours ouvrés. Photographiez tout avant la moindre bâche.
          </p>
        </article>
      </div>

      <aside class="assur__note">
        <p>
          <strong>Le motif de refus le plus fréquent est le défaut d'entretien.</strong> Un assureur
          peut réduire ou refuser sa prise en charge s'il établit que le désordre résulte de la
          vétusté ou d'un manque d'entretien manifeste de la toiture. C'est la raison la plus
          concrète de faire contrôler une couverture avant qu'elle ne pose problème — et l'un des
          rares arguments d'entretien qui ne soit pas commercial.
        </p>
        <p class="assur__links">
          <a href="/demoussage-toiture/" class="link-arrow">Entretien et contrôle de couverture</a>
          <a href="/prix-toiture/" class="link-arrow">Ce que coûte une réparation</a>
        </p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <RealisationsBlock
        items={realisations}
        title="Interventions sur infiltration dans le secteur"
        moreHref="/realisations/"
        hideIfEmpty
      />
      <Faq items={faqItems} title="Questions sur les fuites de toiture" />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <CityLinks
        service="fuite-toiture"
        title="Nous intervenons sur les infiltrations dans ces communes"
        text="La proximité compte particulièrement sur ce type de demande : plus la commune est proche de notre local de Béthune, plus il nous est facile de passer constater rapidement."
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <RelatedServices
        service="fuite-toiture"
        title="Après la recherche, la réparation"
        intro="Selon l'origine trouvée, l'intervention relève de l'une de ces prestations."
      />
    </div>
  </section>

  <CtaBand
    variant="deep"
    eyebrow="Infiltration"
    title="Décrivez ce que vous voyez, on s’occupe du reste"
    text="Une photo de la trace et quelques précisions suffisent pour que nous arrivions préparés. Nous rappelons pour situer l'origine avant de nous déplacer."
    primaryLabel="Signaler une fuite"
    service="fuite-toiture"
    trackLabel="fuite-final"
  />
</BaseLayout>

<style>
  /* ------------------------------------------------------------ assurance */
  .assur { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-7); margin-top: var(--sp-8); }
  @media (max-width: 860px) { .assur { grid-template-columns: minmax(0, 1fr); gap: var(--sp-6); } }
  .assur__cas { padding-top: var(--sp-5); border-top: 2px solid var(--rule); }
  .assur__cas--oui { border-top-color: var(--verdi-500); }
  .assur__cas--non { border-top-color: var(--clay-500); }
  .assur__cas--peut { border-top-color: var(--zinc-400); }
  .assur__k { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); }
  .assur__cas h3 { margin-top: var(--sp-2); font-size: var(--fs-lg); }
  .assur__cas p:last-child { margin-top: var(--sp-3); font-size: var(--fs-sm); color: var(--text-muted); }
  .assur__note { margin-top: var(--sp-8); padding: var(--sp-6) var(--sp-7); background: var(--surface); border-left: 3px solid var(--clay-500); }
  .assur__note p { max-width: 74ch; }
  .assur__links { display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-7); margin-top: var(--sp-5); }

  /* ------------------------------------------------------ que faire now */
  .now {
    background: var(--alert-bg);
    border-bottom: 1px solid var(--alert-border);
    padding-block: var(--sp-7);
  }
  .now__title {
    font-size: var(--fs-xl);
    color: var(--alert-ink);
