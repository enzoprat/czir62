# ---------------------------------------------------------------------------
# CZIR62 - Variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs reelles.
# ---------------------------------------------------------------------------

# --- Destinations des leads (toutes optionnelles, cumulables) ---------------
# Chaque sink actif recoit le meme payload normalise (voir src/lib/leads/types.ts)

# Webhook generique / n8n / Make / Zapier
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Google Sheets via Apps Script Web App (URL /exec)
LEAD_SHEETS_URL=

# CRM (endpoint HTTP custom)
LEAD_CRM_URL=
LEAD_CRM_TOKEN=

# Email transactionnel (Resend). Laisser vide pour desactiver.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Journal local NDJSON (toujours actif en dev, filet de securite)
LEAD_LOG_FILE=.leads/leads.ndjson

# --- Anti-spam --------------------------------------------------------------
# Laisser vide pour desactiver la verification (le honeypot + time-trap restent actifs)
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# --- Analytics --------------------------------------------------------------
# Identifiant GA4 (G-XXXXXXXXXX) ou conteneur GTM (GTM-XXXXXXX).
# Laisser vide tant que le compte n'est pas cree : aucun script ne sera injecte.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=

# --- Endpoint alternatif (hebergement 100% statique) ------------------------
# Si le site est deploye sans runtime Node, pointer le formulaire vers un
# webhook externe. Sinon laisser vide : /api/lead/ est utilise.
PUBLIC_LEAD_ENDPOINT=
